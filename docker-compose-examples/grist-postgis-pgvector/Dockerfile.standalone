# Dockerfile standalone pour Grist avec PostGIS et pgvector intégrés
FROM postgis/postgis:16-3.4

# Variables d'environnement
ENV GRIST_SPATIAL_ENABLED=true
ENV GRIST_VECTOR_ENABLED=true
ENV NODE_ENV=production
ENV GRIST_DATA_DIR=/persist/docs
ENV GRIST_INST_DIR=/persist
ENV PYTHON_VERSION=3
ENV GRIST_SANDBOXED=false
ENV POSTGRES_DB=grist
ENV POSTGRES_USER=grist
ENV POSTGRES_PASSWORD=grist123

# Installer Node.js et dépendances système
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    build-essential \
    git \
    python3 \
    python3-pip \
    supervisor \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Installer pgvector
RUN cd /tmp \
    && git clone --branch v0.5.1 https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make clean \
    && make OPTFLAGS="" \
    && make install \
    && cd / \
    && rm -rf /tmp/pgvector

# Créer l'utilisateur grist
RUN groupadd -g 2000 grist && useradd -r -u 2000 -g grist grist

# Créer les répertoires
RUN mkdir -p /grist /persist && chown -R grist:grist /persist

# Copier le code Grist
WORKDIR /grist
COPY --chown=grist:grist ../../ .

# Installer les dépendances Grist
RUN npm install --production && npm cache clean --force

# Installer les dépendances Python
RUN pip3 install --no-cache-dir --break-system-packages \
    astor \
    chardet \
    six \
    python-dateutil

# Configuration PostgreSQL pour accepter les connexions locales
RUN echo "host all all 127.0.0.1/32 trust" >> /etc/postgresql/16/main/pg_hba.conf \
    && echo "listen_addresses = '*'" >> /etc/postgresql/16/main/postgresql.conf

# Script d'initialisation des extensions
RUN mkdir -p /docker-entrypoint-initdb.d
COPY init-extensions.sql /docker-entrypoint-initdb.d/01-init-extensions.sql

# Configuration supervisor
COPY supervisor.conf /etc/supervisor/conf.d/supervisor.conf

# Scripts de démarrage
COPY start-services.sh /usr/local/bin/start-services.sh
RUN chmod +x /usr/local/bin/start-services.sh

# Permissions
RUN chown -R grist:grist /grist
RUN chown -R postgres:postgres /var/lib/postgresql

# Port d'exposition
EXPOSE 8484 5432

# Commande de démarrage
CMD ["/usr/local/bin/start-services.sh"]