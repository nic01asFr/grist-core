# Dockerfile pour Grist avec PostgreSQL + PostGIS + pgvector intégrés
# Version corrigée pour Debian Bookworm

FROM gristlabs/grist:latest

# Passer en root pour les installations
USER root

# Installation PostgreSQL 15 (disponible dans Debian Bookworm) + PostGIS + pgvector
RUN apt-get update && \
    apt-get install -y wget ca-certificates gnupg2 && \
    wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | apt-key add - && \
    echo "deb http://apt.postgresql.org/pub/repos/apt/ bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        postgresql-15 \
        postgresql-contrib-15 \
        postgresql-15-postgis-3 \
        postgresql-server-dev-15 \
        build-essential \
        git \
        clang \
        cmake \
        supervisor && \
    cd /tmp && \
    git clone --branch v0.5.1 --depth 1 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && \
    make install && \
    cd / && \
    rm -rf /tmp/pgvector && \
    apt-get remove -y build-essential git postgresql-server-dev-15 && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/*

# Configuration PostgreSQL et répertoires
RUN mkdir -p /var/lib/postgresql/data /run/postgresql /var/log/supervisor && \
    chown -R postgres:postgres /var/lib/postgresql /run/postgresql && \
    chmod 755 /var/lib/postgresql

# Initialisation PostgreSQL (version 15)
USER postgres
RUN /usr/lib/postgresql/15/bin/initdb -D /var/lib/postgresql/data \
    --auth-local=trust --auth-host=md5 --no-locale --encoding=UTF8 && \
    echo "listen_addresses = '127.0.0.1'" >> /var/lib/postgresql/data/postgresql.conf && \
    echo "port = 5432" >> /var/lib/postgresql/data/postgresql.conf && \
    echo "shared_preload_libraries = 'postgis-3,vector'" >> /var/lib/postgresql/data/postgresql.conf && \
    echo "host all all 127.0.0.1/32 md5" >> /var/lib/postgresql/data/pg_hba.conf

USER root

# Configuration Supervisor pour PostgreSQL 15
RUN echo '[supervisord]\n\
nodaemon=true\n\
logfile=/tmp/supervisord.log\n\
pidfile=/tmp/supervisord.pid\n\
\n\
[program:postgres-init]\n\
command=/bin/bash -c "su - postgres -c '\''/usr/lib/postgresql/15/bin/pg_ctl -D /var/lib/postgresql/data -l /tmp/postgres_init.log start'\'' && sleep 5 && su - postgres -c '\''psql -c \"CREATE USER grist WITH PASSWORD '\''grist_simple_2024'\''\"'\'' 2>/dev/null || true && su - postgres -c '\''psql -c \"CREATE DATABASE grist OWNER grist\"'\'' 2>/dev/null || true && su - postgres -c '\''psql -d grist -c \"CREATE EXTENSION IF NOT EXISTS postgis\"'\'' && su - postgres -c '\''psql -d grist -c \"CREATE EXTENSION IF NOT EXISTS vector\"'\'' && echo '\''✅ Base de données initialisée'\'' && su - postgres -c '\''/usr/lib/postgresql/15/bin/pg_ctl -D /var/lib/postgresql/data stop'\'' && sleep 2"\n\
autorestart=false\n\
priority=100\n\
stdout_logfile=/tmp/postgres_init_out.log\n\
stderr_logfile=/tmp/postgres_init_err.log\n\
\n\
[program:postgresql]\n\
command=/usr/lib/postgresql/15/bin/postgres -D /var/lib/postgresql/data\n\
user=postgres\n\
autorestart=true\n\
priority=200\n\
stdout_logfile=/tmp/postgresql.log\n\
stderr_logfile=/tmp/postgresql_error.log\n\
depends_on=postgres-init\n\
\n\
[program:grist]\n\
command=/bin/bash -c "sleep 10 && cd /grist && node ./sandbox/supervisor.mjs"\n\
user=grist\n\
autorestart=true\n\
priority=300\n\
stdout_logfile=/tmp/grist.log\n\
stderr_logfile=/tmp/grist_error.log\n\
depends_on=postgresql' > /etc/supervisor/conf.d/supervisord.conf

# Script d'entrée simplifié
RUN echo '#!/bin/bash\n\
set -e\n\
echo "🚀 Démarrage Grist intégré avec PostgreSQL 15 + PostGIS + pgvector"\n\
chown -R postgres:postgres /var/lib/postgresql\n\
chown -R grist:grist /grist /persist 2>/dev/null || true\n\
exec "$@"' > /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

# Configuration environnement PostgreSQL intégré
ENV TYPEORM_TYPE=postgres \
    TYPEORM_HOST=127.0.0.1 \
    TYPEORM_PORT=5432 \
    TYPEORM_DATABASE=grist \
    TYPEORM_USERNAME=grist \
    TYPEORM_PASSWORD=grist_simple_2024 \
    TYPEORM_LOGGING=false

EXPOSE 8484

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]