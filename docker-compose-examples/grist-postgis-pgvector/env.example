# Configuration pour Grist avec PostGIS et pg_vector
# Copier ce fichier vers .env et adapter les valeurs

# Mot de passe sécurisé pour la base de données PostgreSQL
DATABASE_PASSWORD=change_me_to_a_secure_password

# Répertoire local pour la persistance des données
# Tous les volumes Docker seront montés dans ce répertoire
PERSIST_DIR=./persist

# Port d'exposition de Grist (optionnel, défaut: 8484)
# GRIST_PORT=8484

# Configuration avancée PostgreSQL (optionnel)
# POSTGRES_SHARED_PRELOAD_LIBRARIES=postgis-3
# POSTGRES_LOG_STATEMENT=all
