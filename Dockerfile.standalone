# Dockerfile standalone pour Grist avec PostGIS et pgvector intégrés
FROM node:18-bookworm

# Variables d'environnement
ENV GRIST_SPATIAL_ENABLED=true
ENV GRIST_VECTOR_ENABLED=true
ENV NODE_ENV=production
ENV GRIST_DATA_DIR=/persist/docs
ENV GRIST_INST_DIR=/persist
ENV PYTHON_VERSION=3
ENV GRIST_SANDBOXED=false

# Installer PostgreSQL, PostGIS et dépendances
RUN apt-get update && apt-get install -y \
    postgresql-16 \
    postgresql-16-postgis-3 \
    postgresql-16-postgis-3-scripts \
    postgresql-contrib-16 \
    build-essential \
    git \
    python3 \
    python3-pip \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Installer pgvector
RUN cd /tmp \
    && git clone --branch v0.5.1 https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make clean \
    && make OPTFLAGS="" \
    && make install \
    && cd / \
    && rm -rf /tmp/pgvector

# Créer l'utilisateur grist
RUN groupadd -g 2000 grist && useradd -r -u 2000 -g grist grist

# Créer les répertoires
WORKDIR /grist
RUN mkdir -p /persist && chown -R grist:grist /persist

# Copier le code source complet
COPY --chown=grist:grist . .

# Installer les dépendances Node.js
RUN npm install && npm cache clean --force

# Installer les dépendances Python
RUN pip3 install --no-cache-dir --break-system-packages \
    astor \
    chardet \
    six \
    python-dateutil

# Configuration PostgreSQL
USER postgres
RUN echo "host all all 127.0.0.1/32 trust" >> /etc/postgresql/16/main/pg_hba.conf \
    && echo "listen_addresses = '*'" >> /etc/postgresql/16/main/postgresql.conf \
    && service postgresql start \
    && createdb grist \
    && psql -c "CREATE USER grist WITH PASSWORD 'grist123';" \
    && psql -c "GRANT ALL PRIVILEGES ON DATABASE grist TO grist;" \
    && psql -d grist -c "CREATE EXTENSION IF NOT EXISTS postgis;" \
    && psql -d grist -c "CREATE EXTENSION IF NOT EXISTS vector;" \
    && service postgresql stop

USER root

# Build Grist
RUN npm run build

# Configuration supervisor
COPY docker-compose-examples/grist-postgis-pgvector/supervisor-standalone.conf /etc/supervisor/conf.d/supervisor.conf

# Script de démarrage
COPY docker-compose-examples/grist-postgis-pgvector/start-standalone.sh /usr/local/bin/start-standalone.sh
RUN chmod +x /usr/local/bin/start-standalone.sh

# Permissions finales
RUN chown -R grist:grist /grist
RUN mkdir -p /var/log/supervisor

# Port d'exposition
EXPOSE 8484

# Commande de démarrage
CMD ["/usr/local/bin/start-standalone.sh"]