# Dockerfile simple pour Grist avec extensions spatiales
FROM gristlabs/grist:latest

# Installer axios pour l'API Albert
RUN npm install axios

# Copier nos extensions spatiales compilées
ADD ./compiled-extensions /grist/spatial-extensions

# Créer un script wrapper qui charge les extensions au démarrage
RUN cat > /grist/spatial-wrapper.sh << 'EOF'
#!/bin/bash
echo "🚀 Démarrage de Grist avec extensions spatiales..."

# Charger les extensions dans Node.js
node -e "
console.log('💉 Chargement des extensions spatiales...');
try {
  const spatialFunctions = require('/grist/spatial-extensions/NativeSpatialFunctions.js');
  const { SpatialVectorService } = require('/grist/spatial-extensions/SpatialVectorService.js');
  
  // Créer le service global
  global.spatialService = new SpatialVectorService();
  
  // Ajouter toutes les fonctions au contexte global
  Object.keys(spatialFunctions).forEach(funcName => {
    global[funcName] = spatialFunctions[funcName];
    console.log('  ✓ ' + funcName);
  });
  
  console.log('✅ Extensions chargées: ' + Object.keys(spatialFunctions).length + ' fonctions');
  
  // Test rapide
  const dist = spatialFunctions.GEO_DISTANCE('POINT(2.3522 48.8566)', 'POINT(2.3488 48.8534)');
  console.log('🧪 Test GEO_DISTANCE: ' + Math.round(dist) + 'm');
  
} catch (error) {
  console.log('❌ Erreur chargement: ' + error.message);
}
" || true

# Démarrer Grist normalement
exec /usr/local/bin/docker-entrypoint.sh
EOF

# Rendre le script exécutable
RUN chmod +x /grist/spatial-wrapper.sh

# Variables d'environnement pour les extensions
ENV ALBERT_API_TOKEN="sk-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo5MywidG9rZW5faWQiOjExODksImV4cGlyZXNfYXQiOjE3NzgxOTEyMDB9.mXyNfn1kLYP3hNe5lzraEHjGAbfyB-YfiNpsnp52f80"
ENV ALBERT_API_URL="https://albert.api.etalab.gouv.fr/v1"
ENV GRIST_SPATIAL_ENABLED="true"
ENV GRIST_VECTOR_ENABLED="true"

# Utiliser notre wrapper comme point d'entrée
ENTRYPOINT ["/grist/spatial-wrapper.sh"]