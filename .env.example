# Grist Environment Configuration
# Copy this file to .env and customize as needed

# Session Secret (REQUIRED - Change this!)
# Generate with: openssl rand -base64 32
GRIST_SESSION_SECRET=change-this-secret-key-to-something-secure

# Database
DATABASE_PASSWORD=grist_demo_2024

# Persist directory
PERSIST_DIR=./persist

# Albert API Configuration (for AI features)
ALBERT_API_URL=https://albert.api.etalab.gouv.fr/v1
ALBERT_API_TOKEN=your-albert-api-token
ALBERT_MODEL=albert-large
ALBERT_MODEL_EMBEDDING=embeddings-small
EMBEDDING_DIMENSION=1024

# Authentication (Optional)
# Uncomment and set if you want to use a default email for single-user setup
# GRIST_DEFAULT_EMAIL=your-email@example.com

# Advanced Configuration (Optional)
# GRIST_FORCE_LOGIN=true
# GRIST_ANON_PLAYGROUND=false
# GRIST_TELEMETRY_LEVEL=off
